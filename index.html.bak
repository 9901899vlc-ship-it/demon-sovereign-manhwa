      { num: 7, title: "THE BROTHER'S TRUTH", chapters: "Ch. 64 – 73", panels: "300 Panels", status: "Planned", desc: "The forbidden experiments revealed; Ha-Jun discovers Tae-Jun is alive in the Nether Boundary." },
      { num: 8, title: "THE MYTHIC AWAKENING", chapters: "Ch. 74 – 83", panels: "300 Panels", status: "Planned", desc: "Kuro's true demonic form revealed; synchronization with the Hourglass of Eternal Abyss." },
      { num: 9, title: "THE WAR OF SOVEREIGNS", chapters: "Ch. 84 – 93", panels: "300 Panels", status: "Planned", desc: "Three Demon Sovereigns invade Earth; the Siege of Saint Mirren University begins." },
      { num: 10, title: "THE SOVEREIGN ASCENDANT", chapters: "Ch. 94 – 103", panels: "300 Panels", status: "Planned", desc: "100% Bloodline Synchronization; Ha-Jun takes the Abyssal Throne as the True Sovereign." }
    ];

    let currentChapterIndex = 0;
    let currentViewMode = "strip"; // 'strip' | 'grid' | 'script'

    // =======================================================
    // INITIALIZATION & EVENT LISTENERS
    // =======================================================
    window.addEventListener('DOMContentLoaded', () => {
      renderDrawerChapters();
      renderRelics();
      renderCharacters();
      renderArcs();
      loadChapter(0);
      setupScrollProgress();
      setupDrawerEvents();
    });

    // Scroll Progress
    function setupScrollProgress() {
      window.addEventListener('scroll', () => {
        const winScroll = document.documentElement.scrollTop || document.body.scrollTop;
        const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
        const scrolled = height > 0 ? (winScroll / height) * 100 : 0;
        document.getElementById('progress-bar').style.width = scrolled + '%';
        document.getElementById('page-percent').innerText = Math.round(scrolled) + '%';
      });
    }

    // Tab Switching
    function switchTab(tabId) {
      const tabs = ['reader', 'bible', 'relics', 'characters', 'production'];
      tabs.forEach(t => {
        const view = document.getElementById('tab-view-' + t);
        const btn = document.getElementById('tab-btn-' + t);
        if (t === tabId) {
          view.classList.remove('hidden');
          btn.className = "text-purple-400 border-b-2 border-purple-500 pb-1 px-2 flex items-center gap-1.5 font-bold";
        } else {
          view.classList.add('hidden');
          btn.className = "text-zinc-400 hover:text-zinc-200 pb-1 px-2 flex items-center gap-1.5 font-bold";
        }
      });
      window.scrollTo({top: 0, behavior: 'smooth'});
    }

    // View Mode Switching (Strip vs Grid vs Script)
    function switchViewMode(mode) {
      currentViewMode = mode;
      const stripContainer = document.getElementById('strip-container');
      const gridContainer = document.getElementById('grid-container');
      const scriptContainer = document.getElementById('script-container');
      const btnStrip = document.getElementById('btn-mode-strip');
      const btnGrid = document.getElementById('btn-mode-grid');
      const btnScript = document.getElementById('btn-mode-script');

      stripContainer.classList.add('hidden');
      gridContainer.classList.add('hidden');
      scriptContainer.classList.add('hidden');
      btnStrip.className = "px-2.5 py-1 rounded text-zinc-400 hover:text-white font-medium transition-all";
      btnGrid.className = "px-2.5 py-1 rounded text-zinc-400 hover:text-white font-medium transition-all";
      btnScript.className = "px-2.5 py-1 rounded text-zinc-400 hover:text-white font-medium transition-all";

      if (mode === 'strip') {
        stripContainer.classList.remove('hidden');
        btnStrip.className = "px-2.5 py-1 rounded bg-purple-600 text-white font-bold transition-all";
      } else if (mode === 'grid') {
        gridContainer.classList.remove('hidden');
        btnGrid.className = "px-2.5 py-1 rounded bg-purple-600 text-white font-bold transition-all";
      } else if (mode === 'script') {
        scriptContainer.classList.remove('hidden');
        btnScript.className = "px-2.5 py-1 rounded bg-purple-600 text-white font-bold transition-all";
      }
    }

    // Load Specific Chapter
    function loadChapter(index) {
      if (index < 0 || index >= CHAPTERS_DATA.length) return;
      currentChapterIndex = index;
      const chap = CHAPTERS_DATA[index];

      // Update Header & Badge
      document.getElementById('header-chapter-badge').innerText = `CH. ${chap.number}`;
      document.getElementById('header-chapter-title').innerText = `${chap.arc} • ${chap.title}`;
      document.getElementById('footer-chapter-desc').innerText = chap.desc;
      document.getElementById('comments-chapter-label').innerText = `Chapter ${chap.number}: ${chap.title}`;

      // Populate Strip Container
      const strip = document.getElementById('webtoon-strip');
      strip.innerHTML = '';

      if (chap.stripImg) {
        // High-resolution continuous webtoon stitched strip
        const img = document.createElement('img');
        img.src = chap.stripImg;
        img.alt = chap.title;
        img.className = 'webtoon-panel-img';
        img.loading = 'lazy';
        strip.appendChild(img);
      } else if (chap.panels && chap.panels.length > 0) {
        chap.panels.forEach((src, pIdx) => {
          const img = document.createElement('img');
          img.src = src;
          img.alt = `${chap.title} - Panel ${pIdx + 1}`;
          img.className = 'webtoon-panel-img';
          img.loading = 'lazy';
          strip.appendChild(img);
        });
      } else {
        // Scripted chapter notice with action button
        strip.innerHTML = `
          <div class="p-8 text-center space-y-4">
            <span class="inline-block p-4 rounded-full bg-purple-950/70 border border-purple-700/50 text-purple-400 text-2xl">📜</span>
            <h3 class="text-lg font-bold text-white font-cinzel">${chap.title}</h3>
            <p class="text-xs text-zinc-400 max-w-md mx-auto leading-relaxed">${chap.desc}</p>
            <div class="pt-4">
              <button onclick="switchViewMode('script')" class="px-5 py-2.5 bg-purple-600 hover:bg-purple-500 text-white font-bold text-xs rounded-xl shadow-lg transition-all">
                Read 30-Panel Screenplay & Dialogue →
              </button>
            </div>
          </div>
        `;
      }

      // Populate Grid Container
      const grid = document.getElementById('grid-panel-wrapper');
      grid.innerHTML = '';
      if (chap.panels && chap.panels.length > 0) {
        chap.panels.forEach((src, pIdx) => {
          const card = document.createElement('div');
          card.className = "bg-zinc-900 border border-zinc-800 rounded-xl overflow-hidden hover:border-purple-500 transition-all cursor-pointer group";
          card.onclick = () => { switchViewMode('strip'); };
          card.innerHTML = `
            <img src="${src}" alt="Panel ${pIdx + 1}" class="w-full h-auto object-cover group-hover:scale-105 transition-transform duration-300" loading="lazy">
            <div class="p-2 text-center text-[10px] font-bold text-zinc-400 group-hover:text-purple-300">
              Panel ${pIdx + 1}
            </div>
          `;
          grid.appendChild(card);
        });
      } else if (chap.gridImg) {
        grid.innerHTML = `<img src="${chap.gridImg}" alt="${chap.title} Overview" class="w-full col-span-3 rounded-xl border border-zinc-800">`;
      } else {
        grid.innerHTML = `<p class="col-span-3 text-center text-xs text-zinc-500 py-10">Art panels currently staged in production pipeline.</p>`;
      }

      // Populate Script Container
      loadChapterScript(chap);

      // Close drawer if open
      document.getElementById('chapter-drawer').classList.add('hidden');
      window.scrollTo({top: 0, behavior: 'smooth'});
    }

    // Load Chapter Screenplay
    async function loadChapterScript(chap) {
      const scriptWrapper = document.getElementById('script-panel-wrapper');
      scriptWrapper.innerHTML = `
        <div class="sovereign-card rounded-2xl p-6 space-y-2 border-purple-500/30">
          <div class="flex items-center justify-between text-xs font-bold text-purple-400 font-orbitron">
            <span>CHAPTER ${chap.number} SCREENPLAY</span>
            <span class="bg-purple-950 text-purple-300 px-2 py-0.5 rounded border border-purple-800">30 PANELS</span>
          </div>
          <h2 class="text-xl font-bold font-cinzel text-white">${chap.title}</h2>
          <p class="text-xs text-zinc-400 leading-relaxed">${chap.desc}</p>
        </div>
      `;

      if (chap.scriptFile) {
        try {
          const res = await fetch(chap.scriptFile);
          if (res.ok) {
            const data = await res.json();
            if (data.panels) {
              data.panels.forEach(p => {
                const card = document.createElement('div');
                card.className = "bg-zinc-950/80 border border-zinc-800/80 hover:border-purple-500/50 rounded-xl p-4 space-y-3 transition-all";
                let dialogueHtml = '';
                if (p.dialogue && p.dialogue.length > 0) {
                  p.dialogue.forEach(d => {
                    dialogueHtml += `
                      <div class="bg-purple-950/40 border-l-2 border-purple-500 p-2.5 rounded-r-lg text-xs space-y-1">
                        <span class="font-bold text-purple-300 uppercase tracking-wider text-[10px]">${d.speaker || d.type}:</span>
                        <p class="text-zinc-200 font-medium">"${d.text}"</p>
                      </div>
                    `;
                  });
                }
                card.innerHTML = `
                  <div class="flex items-center justify-between text-xs">
                    <span class="font-bold font-orbitron text-purple-400 uppercase">${p.id} • ${p.shot}</span>
                    <span class="text-zinc-500 text-[10px]">${p.setting}</span>
                  </div>
                  <p class="text-xs text-zinc-300 leading-relaxed">${p.action}</p>
                  ${p.sfx ? `<div class="text-[11px] font-bold text-amber-400 font-orbitron">SFX: ${p.sfx}</div>` : ''}
                  ${dialogueHtml}
                `;
                scriptWrapper.appendChild(card);
              });
            }
          }
        } catch (e) {
          console.warn("Could not load script JSON directly:", e);
        }
      }
    }

    function nextChapter() {
      if (currentChapterIndex < CHAPTERS_DATA.length - 1) {
        loadChapter(currentChapterIndex + 1);
      }
    }

    function prevChapter() {
      if (currentChapterIndex > 0) {
        loadChapter(currentChapterIndex - 1);
      }
    }

    // Render Drawer Chapters
    function renderDrawerChapters() {
      const list = document.getElementById('drawer-chapters-list');
      list.innerHTML = '';
      CHAPTERS_DATA.forEach((c, idx) => {
        const item = document.createElement('div');
        item.className = "p-3 rounded-xl bg-zinc-900/60 hover:bg-purple-950/50 border border-zinc-800/80 hover:border-purple-600 transition-all cursor-pointer flex items-center justify-between";
        item.onclick = () => { loadChapter(idx); };
        item.innerHTML = `
          <div>
            <div class="flex items-center gap-2">
              <span class="text-xs font-bold text-purple-400 font-orbitron">CH. ${c.number}</span>
              <span class="text-[9px] text-zinc-500 uppercase">${c.arc}</span>
            </div>
            <h4 class="text-xs font-bold text-white mt-0.5">${c.title}</h4>
          </div>
          <span class="text-[10px] px-2 py-0.5 rounded font-bold ${c.status === 'complete' ? 'bg-emerald-950 text-emerald-300 border border-emerald-800' : 'bg-purple-950 text-purple-300 border border-purple-800'}">
            ${c.status === 'complete' ? 'READ' : 'SCRIPTED'}
          </span>
        `;
        list.appendChild(item);
      });
    }

    // Render 10 Relics
    function renderRelics() {
      const container = document.getElementById('relics-grid');
      container.innerHTML = '';
      RELICS_DATA.forEach((r, idx) => {
        const card = document.createElement('div');
        card.className = `rounded-2xl p-5 border ${r.border} bg-gradient-to-br ${r.color} space-y-2.5 shadow-lg`;
        card.innerHTML = `
          <div class="flex items-center justify-between text-xs font-bold">
            <span class="font-orbitron text-white text-sm">#${idx + 1} ${r.name}</span>
            <span class="px-2 py-0.5 rounded text-[10px] bg-black/60 font-bold border border-white/20">${r.tier}</span>
          </div>
          <p class="text-xs text-zinc-300 leading-relaxed font-medium">${r.power}</p>
          <div class="pt-1 flex items-center justify-between text-[10px] text-zinc-400 font-semibold border-t border-white/10">
            <span>Availability: ${r.status}</span>
          </div>
        `;
        container.appendChild(card);
      });
    }

    // Render Characters
    function renderCharacters() {
      const container = document.getElementById('characters-grid');
      container.innerHTML = '';
      CHARACTERS_DATA.forEach(ch => {
        const card = document.createElement('div');
        card.className = "sovereign-card rounded-2xl p-5 space-y-3";
        card.innerHTML = `
          <div class="flex items-start justify-between">
            <div>
              <h4 class="text-sm font-bold text-white font-cinzel">${ch.name}</h4>
              <span class="text-xs text-purple-400 font-semibold">${ch.role}</span>
            </div>
            <span class="text-[10px] px-2 py-0.5 rounded border font-bold ${ch.tagColor}">${ch.tag}</span>
          </div>
          <p class="text-xs text-zinc-300 leading-relaxed">${ch.desc}</p>
        `;
        container.appendChild(card);
      });
    }

    // Render 10 Arcs Directory
    function renderArcs() {
      const container = document.getElementById('arcs-list-container');
      container.innerHTML = '';
      ARCS_DATA.forEach(arc => {
        const item = document.createElement('div');
        item.className = "sovereign-card rounded-2xl p-5 space-y-2 border-zinc-800 hover:border-purple-600/50 transition-all";
        item.innerHTML = `
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
            <div>
              <span class="text-[10px] font-bold text-purple-400 font-orbitron uppercase">ARC ${arc.num} • ${arc.chapters}</span>
              <h3 class="text-base font-bold font-cinzel text-white mt-0.5">${arc.title}</h3>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-[11px] bg-zinc-900 border border-zinc-800 px-2 py-0.5 rounded font-mono text-zinc-300">${arc.panels}</span>
              <span class="text-[10px] bg-purple-950 text-purple-300 border border-purple-800 px-2 py-0.5 rounded font-bold">${arc.status}</span>
            </div>
          </div>
          <p class="text-xs text-zinc-400 leading-relaxed">${arc.desc}</p>
        `;
        container.appendChild(item);
      });
    }

    // Drawer Setup
    function setupDrawerEvents() {
      const drawer = document.getElementById('chapter-drawer');
      document.getElementById('open-drawer-btn').onclick = () => drawer.classList.remove('hidden');
      document.getElementById('close-drawer-btn').onclick = () => drawer.classList.add('hidden');
      drawer.onclick = (e) => { if (e.target === drawer) drawer.classList.add('hidden'); };

      // Comments Drawer
      const commentBtn = document.getElementById('comment-btn');
      const commentsDrawer = document.getElementById('comments-drawer');
      const closeCommentsBtn = document.getElementById('close-comments-btn');
      if (commentBtn && commentsDrawer && closeCommentsBtn) {
        commentBtn.onclick = () => commentsDrawer.classList.remove('hidden');
        closeCommentsBtn.onclick = () => commentsDrawer.classList.add('hidden');
        commentsDrawer.onclick = (e) => { if (e.target === commentsDrawer) commentsDrawer.classList.add('hidden'); };
      }
    }

    function shareChapter() {
      if (navigator.share) {
        navigator.share({
          title: "Demon Sovereign's Bloodline",
          text: "Read the dark fantasy epic Demon Sovereign's Bloodline!",
          url: window.location.href
        }).catch(() => {});
      } else {
        navigator.clipboard.writeText(window.location.href);
        alert("Link copied to clipboard!");
      }
    }
  </script>
</body>
</html>
