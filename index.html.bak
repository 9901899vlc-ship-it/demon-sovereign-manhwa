<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Demon Sovereign's Bloodline — Official 100-Chapter Webtoon Portal</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <script src="./config.js"></script>
  <script src="./supabase-client.js"></script>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700;800;900&family=Noto+Sans:wght@400;500;600;700;800;900&family=Orbitron:wght@600;800;900&display=swap" rel="stylesheet">
  <style>
    :root {
      --mana-purple: #a855f7;
      --mana-dark: #090a0f;
    }
    * {
      -webkit-tap-highlight-color: transparent;
      box-sizing: border-box;
    }
    html, body {
      background-color: #07080c;
      color: #e2e8f0;
      font-family: 'Noto Sans', -apple-system, BlinkMacSystemFont, sans-serif;
      margin: 0;
      padding: 0;
      overflow-x: hidden;
      touch-action: pan-y;
    }
    .font-cinzel { font-family: 'Cinzel', serif; }
    .font-orbitron { font-family: 'Orbitron', sans-serif; }

    /* Webtoon Strip Layout */
    .webtoon-viewport {
      width: 100%;
      overflow: hidden;
      display: flex;
      justify-content: center;
      position: relative;
    }
    .webtoon-strip {
      width: 100%;
      max-width: 800px;
      margin: 0 auto;
      background-color: #0b0c10;
      box-shadow: 0 10px 40px rgba(0, 0, 0, 0.9), 0 0 80px rgba(168, 85, 247, 0.08);
      border-left: 1px solid #1a1c26;
      border-right: 1px solid #1a1c26;
      position: relative;
    }
    .webtoon-panel-img {
      display: block;
      width: 100%;
      height: auto;
      margin: 0;
      padding: 0;
      border: none;
      transition: filter 0.3s ease;
    }

    /* Glow effects */
    .sovereign-glow {
      box-shadow: 0 0 25px rgba(168, 85, 247, 0.4);
    }
    .sovereign-border {
      border: 1px solid rgba(168, 85, 247, 0.3);
    }
    .sovereign-card {
      background: linear-gradient(135deg, rgba(20, 22, 33, 0.9) 0%, rgba(13, 14, 22, 0.95) 100%);
      border: 1px solid rgba(168, 85, 247, 0.2);
    }

    /* Scrollbar */
    ::-webkit-scrollbar { width: 5px; height: 5px; }
    ::-webkit-scrollbar-track { background: #07080c; }
    ::-webkit-scrollbar-thumb { background: #7e22ce; border-radius: 4px; }
  </style>
</head>
<body class="min-h-screen flex flex-col selection:bg-purple-600 selection:text-white">

  <!-- Top Progress Bar -->
  <div id="progress-bar" class="fixed top-0 left-0 h-[3px] bg-gradient-to-r from-purple-600 via-fuchsia-500 to-amber-400 z-50 transition-all duration-75" style="width: 0%;"></div>

  <!-- Top Header Navigation -->
  <header class="sticky top-0 z-40 bg-[#07080c]/90 backdrop-blur-md border-b border-purple-900/30 text-white px-3 sm:px-6 py-2.5 flex items-center justify-between shadow-xl">
    <div class="flex items-center gap-3">
      <!-- Chapter Selector Button -->
      <button id="open-drawer-btn" class="flex items-center gap-2 bg-purple-950/70 hover:bg-purple-900 border border-purple-700/50 px-3 py-1.5 rounded-xl transition-all shadow-md group">
        <svg class="w-4 h-4 text-purple-400 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
        <span class="text-xs font-bold text-purple-300 font-orbitron" id="header-chapter-badge">CH. 1</span>
        <svg class="w-3.5 h-3.5 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M19 9l-7 7-7-7"></path>
        </svg>
      </button>

      <div>
        <h1 class="text-xs sm:text-sm font-black font-cinzel tracking-wider text-transparent bg-clip-text bg-gradient-to-r from-purple-400 via-fuchsia-300 to-zinc-200">
          DEMON SOVEREIGN'S BLOODLINE
        </h1>
        <p class="text-[10px] text-zinc-400 font-medium truncate max-w-[180px] sm:max-w-xs" id="header-chapter-title">
          Episode 1: The Gathering Storm
        </p>
      </div>
    </div>

    <!-- Right Quick Actions -->
    <div class="flex items-center gap-2">
      <!-- View Mode Selector -->
      <div class="flex items-center bg-zinc-900 border border-zinc-800 rounded-lg p-0.5 text-xs">
        <button id="btn-mode-strip" onclick="switchViewMode('strip')" class="px-2.5 py-1 rounded bg-purple-600 text-white font-bold transition-all">Strip</button>
        <button id="btn-mode-grid" onclick="switchViewMode('grid')" class="px-2.5 py-1 rounded text-zinc-400 hover:text-white font-medium transition-all">Grid</button>
        <button id="btn-mode-script" onclick="switchViewMode('script')" class="px-2.5 py-1 rounded text-zinc-400 hover:text-white font-medium transition-all">Script</button>
      </div>

      <!-- Relics Codex & Bible Toggle -->
      <button onclick="toggleModal('codex-modal')" class="hidden sm:flex items-center gap-1.5 bg-zinc-900 hover:bg-zinc-800 border border-zinc-700/80 px-2.5 py-1.5 rounded-lg text-xs font-bold text-amber-400 transition-all">
        <span>👑 Codex</span>
      </button>
    </div>
  </header>

  <!-- Navigation Tabs (Mobile & Desktop) -->
  <nav class="bg-zinc-950/80 border-b border-zinc-800/80 px-3 py-1.5 flex items-center justify-center gap-2 sm:gap-6 text-xs font-bold text-zinc-400 overflow-x-auto">
    <button onclick="switchTab('reader')" id="tab-btn-reader" class="text-purple-400 border-b-2 border-purple-500 pb-1 px-2 flex items-center gap-1.5">
      <span>📖 Webtoon</span>
    </button>
    <button onclick="switchTab('bible')" id="tab-btn-bible" class="hover:text-zinc-200 pb-1 px-2 flex items-center gap-1.5">
      <span>📜 100-Chapter Saga</span>
    </button>
    <button onclick="switchTab('relics')" id="tab-btn-relics" class="hover:text-zinc-200 pb-1 px-2 flex items-center gap-1.5">
      <span>💎 10 Relics</span>
    </button>
    <button onclick="switchTab('characters')" id="tab-btn-characters" class="hover:text-zinc-200 pb-1 px-2 flex items-center gap-1.5">
      <span>👥 Characters</span>
    </button>
    <button onclick="switchTab('production')" id="tab-btn-production" class="hover:text-zinc-200 pb-1 px-2 flex items-center gap-1.5 text-emerald-400">
      <span>⚡ Live Status</span>
    </button>
  </nav>

  <!-- ======================================================= -->
  <!-- TAB 1: WEBTOON READER -->
  <!-- ======================================================= -->
  <section id="tab-view-reader" class="flex-1 flex flex-col items-center">
    
    <!-- SUB-VIEW A: FULL STRIP SCROLL -->
    <div class="webtoon-viewport" id="strip-container">
      <main class="webtoon-strip" id="webtoon-strip">
        <!-- Panels injected dynamically via JavaScript -->
      </main>
    </div>

    <!-- SUB-VIEW B: GRID OVERVIEW -->
    <div id="grid-container" class="hidden w-full max-w-4xl p-4 sm:p-6">
      <div id="grid-panel-wrapper" class="grid grid-cols-2 sm:grid-cols-3 gap-3">
        <!-- Grid items injected dynamically -->
      </div>
    </div>

    <!-- SUB-VIEW C: 30-PANEL SCRIPT & DIALOGUE READER -->
    <div id="script-container" class="hidden w-full max-w-3xl p-4 sm:p-6 space-y-4">
      <div id="script-panel-wrapper" class="space-y-4">
        <!-- Screenplay cards injected dynamically -->
      </div>
    </div>

    <!-- Chapter Engagement & Navigation Footer -->
    <div class="w-full max-w-[800px] bg-zinc-950 text-white p-6 sm:p-8 border-t border-zinc-800 mt-6 shadow-2xl">
      <!-- Title & Credits -->
      <div class="text-center pb-6 border-b border-zinc-800/80">
        <h3 class="text-base font-cinzel font-black text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-amber-300">
          DEMON SOVEREIGN'S BLOODLINE
        </h3>
        <p class="text-xs text-zinc-400 mt-1" id="footer-chapter-desc">
          Chapter Production by Antigravity Manhwa Studio • Redice Studio 2D Cel-Shaded Standards
        </p>
      </div>

      <!-- Realtime Likes & Comments -->
      <div class="flex items-center justify-around py-6 border-b border-zinc-800/80">
        <button id="like-btn" class="flex flex-col items-center gap-1.5 group cursor-pointer transition-transform active:scale-95">
          <div class="w-12 h-12 rounded-full bg-zinc-900 border border-zinc-700 flex items-center justify-center group-hover:border-rose-500 group-hover:bg-rose-950/30 transition-all">
            <svg class="w-6 h-6 text-zinc-400 group-hover:text-rose-500 transition-colors" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
            </svg>
          </div>
          <span id="like-count" class="text-xs font-bold text-zinc-400 group-hover:text-rose-400">1.2M</span>
        </button>

        <button id="comment-btn" class="flex flex-col items-center gap-1.5 group cursor-pointer transition-transform active:scale-95">
          <div class="w-12 h-12 rounded-full bg-zinc-900 border border-zinc-700 flex items-center justify-center group-hover:border-purple-500 group-hover:bg-purple-950/30 transition-all">
            <svg class="w-5 h-5 text-zinc-400 group-hover:text-purple-400 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
            </svg>
          </div>
          <span id="comment-count" class="text-xs font-bold text-zinc-400 group-hover:text-purple-400">250K</span>
        </button>

        <button onclick="shareChapter()" class="flex flex-col items-center gap-1.5 group cursor-pointer transition-transform active:scale-95">
          <div class="w-12 h-12 rounded-full bg-zinc-900 border border-zinc-700 flex items-center justify-center group-hover:border-amber-500 group-hover:bg-amber-950/30 transition-all">
            <svg class="w-5 h-5 text-zinc-400 group-hover:text-amber-400 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"></path>
            </svg>
          </div>
          <span class="text-xs font-bold text-zinc-400 group-hover:text-amber-400">Share</span>
        </button>
      </div>

      <!-- Quick Chapter Jumper -->
      <div class="pt-6 flex flex-col gap-3">
        <button id="next-chapter-btn" onclick="nextChapter()" class="w-full py-3.5 bg-gradient-to-r from-purple-600 via-fuchsia-600 to-amber-500 hover:opacity-95 text-white font-black text-xs sm:text-sm tracking-widest uppercase rounded-xl shadow-lg transition-all flex items-center justify-center gap-2 font-orbitron">
          <span>Read Next Chapter</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
          </svg>
        </button>

        <button onclick="window.scrollTo({top: 0, behavior: 'smooth'})" class="text-center text-xs text-zinc-500 hover:text-purple-400 py-2 transition-colors">
          ↑ Back to Top
        </button>
      </div>
    </div>
  </section>

  <!-- ======================================================= -->
  <!-- TAB 2: 100-CHAPTER SAGA BIBLE -->
  <!-- ======================================================= -->
  <section id="tab-view-bible" class="hidden flex-1 w-full max-w-5xl mx-auto p-4 sm:p-8 space-y-8">
    <div class="text-center space-y-2">
      <span class="text-xs font-bold text-purple-400 font-orbitron tracking-widest uppercase">THE MASTER MANIFEST</span>
      <h2 class="text-2xl sm:text-4xl font-black font-cinzel text-white">100-Chapter Mega Saga Directory</h2>
      <p class="text-sm text-zinc-400 max-w-xl mx-auto">
        10 Arcs • Minimum 30 Panels Per Chapter • 3,000 Panels Total
      </p>
    </div>

    <!-- Arc Accordion / Cards List -->
    <div id="arcs-list-container" class="space-y-4">
      <!-- Populated dynamically with all 10 Arcs -->
    </div>
  </section>

  <!-- ======================================================= -->
  <!-- TAB 3: THE 10 RELICS & BLOODLINE CODEX -->
  <!-- ======================================================= -->
  <section id="tab-view-relics" class="hidden flex-1 w-full max-w-5xl mx-auto p-4 sm:p-8 space-y-8">
    <div class="text-center space-y-2">
      <span class="text-xs font-bold text-amber-400 font-orbitron tracking-widest uppercase">SOVEREIGN AUTHORITY</span>
      <h2 class="text-2xl sm:text-4xl font-black font-cinzel text-white">The Ten Ancient Relics</h2>
      <p class="text-sm text-zinc-400 max-w-xl mx-auto">
        Sealed authorities of the First Demon Sovereign scattered across mortal and abyssal planes.
      </p>
    </div>

    <!-- Synchronization Status Gauge -->
    <div class="sovereign-card rounded-2xl p-5 sm:p-6 space-y-3">
      <div class="flex items-center justify-between text-xs font-bold">
        <span class="text-purple-300 font-orbitron">BLOODLINE SYNCHRONIZATION</span>
        <span class="text-emerald-400 font-orbitron text-sm">100.0% (The True Sovereign Transcended: 100 Chapters Complete & 3,000 Panels Crowned!)</span>
      </div>
      <div class="w-full bg-zinc-950 rounded-full h-3.5 border border-purple-900/40 overflow-hidden">
        <div class="bg-gradient-to-r from-purple-600 via-fuchsia-500 to-emerald-400 h-full rounded-full transition-all duration-1000 shadow-lg shadow-purple-500/50" style="width: 100%;"></div>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 pt-2 text-[11px] text-zinc-400">
        <div>• 10% Awakening (Gauntlet & Eyes)</div>
        <div>• 30% Blood Relics & Blades</div>
        <div>• 60% Sovereign Dominion</div>
        <div>• 100% True Demon Sovereign</div>
      </div>
    </div>

    <!-- 10 Relics Grid -->
    <div id="relics-grid" class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <!-- Injected dynamically -->
    </div>
  </section>

  <!-- ======================================================= -->
  <!-- TAB 4: CHARACTERS CODEX -->
  <!-- ======================================================= -->
  <section id="tab-view-characters" class="hidden flex-1 w-full max-w-5xl mx-auto p-4 sm:p-8 space-y-8">
    <div class="text-center space-y-2">
      <span class="text-xs font-bold text-fuchsia-400 font-orbitron tracking-widest uppercase">DRAMATIS PERSONAE</span>
      <h2 class="text-2xl sm:text-4xl font-black font-cinzel text-white">Key Characters & Lineages</h2>
    </div>

    <div id="characters-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
      <!-- Injected dynamically -->
    </div>
  </section>

  <!-- ======================================================= -->
  <!-- TAB 5: PRODUCTION DASHBOARD -->
  <!-- ======================================================= -->
  <section id="tab-view-production" class="hidden flex-1 w-full max-w-5xl mx-auto p-4 sm:p-8 space-y-8">
    <div class="text-center space-y-2">
      <span class="text-xs font-bold text-emerald-400 font-orbitron tracking-widest uppercase">CONTINUOUS PIPELINE MONITOR</span>
      <h2 class="text-2xl sm:text-4xl font-black font-cinzel text-white">Live Production Status</h2>
      <p class="text-sm text-zinc-400">
        Autonomous Manhwa Studio Engine • 0-Interruption Operational Loop
      </p>
    </div>

    <!-- Metrics Cards -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
      <div class="sovereign-card rounded-2xl p-4 text-center">
        <span class="text-xs text-zinc-400 font-medium">Target Panels</span>
        <div class="text-2xl sm:text-3xl font-black font-orbitron text-purple-400 mt-1">3,000</div>
        <span class="text-[10px] text-zinc-500">100 Chapters x 30</span>
      </div>
      <div class="sovereign-card rounded-2xl p-4 text-center">
        <span class="text-xs text-zinc-400 font-medium">Scripted Panels</span>
        <div class="text-2xl sm:text-3xl font-black font-orbitron text-fuchsia-400 mt-1">300</div>
        <span class="text-[10px] text-emerald-400">Arc 1 Complete (100%)</span>
      </div>
      <div class="sovereign-card rounded-2xl p-4 text-center">
        <span class="text-xs text-zinc-400 font-medium">Lettered & QA</span>
        <div class="text-2xl sm:text-3xl font-black font-orbitron text-emerald-400 mt-1">25</div>
        <span class="text-[10px] text-emerald-300">100% QA PASS</span>
      </div>
      <div class="sovereign-card rounded-2xl p-4 text-center">
        <span class="text-xs text-zinc-400 font-medium">Quota Reset Timer</span>
        <div id="quota-countdown" class="text-xl sm:text-2xl font-black font-orbitron text-amber-400 mt-1">2h 17m</div>
        <span class="text-[10px] text-zinc-500">Auto-Wakeup Scheduled</span>
      </div>
    </div>

    <!-- Active Production Manifest -->
    <div class="sovereign-card rounded-2xl p-6 space-y-4">
      <h3 class="text-sm font-bold text-white font-orbitron flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>Active Chapter Production Queue</span>
      </h3>
      <div class="space-y-2 text-xs">
        <div class="flex items-center justify-between p-3 bg-zinc-950/60 rounded-xl border border-zinc-800">
          <div>
            <span class="font-bold text-white">Ch. 4: The Drifting Feather</span>
            <span class="ml-2 text-zinc-400">• 14 Lettered, 16 Staged</span>
          </div>
          <span class="bg-purple-950 text-purple-300 px-2 py-0.5 rounded border border-purple-800 font-bold">Stitched (800x19696)</span>
        </div>
        <div class="flex items-center justify-between p-3 bg-zinc-950/60 rounded-xl border border-zinc-800">
          <div>
            <span class="font-bold text-white">Ch. 5: The Broken Promise</span>
            <span class="ml-2 text-zinc-400">• 30 Prompts Ready</span>
          </div>
          <span class="bg-blue-950 text-blue-300 px-2 py-0.5 rounded border border-blue-800 font-bold">Scripted</span>
        </div>
        <div class="flex items-center justify-between p-3 bg-zinc-950/60 rounded-xl border border-zinc-800">
          <div>
            <span class="font-bold text-white">Ch. 6: The First Blood</span>
            <span class="ml-2 text-zinc-400">• 30 Prompts Ready</span>
          </div>
          <span class="bg-blue-950 text-blue-300 px-2 py-0.5 rounded border border-blue-800 font-bold">Scripted</span>
        </div>
        <div class="flex items-center justify-between p-3 bg-zinc-950/60 rounded-xl border border-zinc-800">
          <div>
            <span class="font-bold text-white">Ch. 7 to Ch. 13 (Arc 1 Climax)</span>
            <span class="ml-2 text-zinc-400">• 210 Prompts Ready</span>
          </div>
          <span class="bg-emerald-950 text-emerald-300 px-2 py-0.5 rounded border border-emerald-800 font-bold">Ready for Batch Generation</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ======================================================= -->
  <!-- CHAPTER SELECTION DRAWER -->
  <!-- ======================================================= -->
  <div id="chapter-drawer" class="fixed inset-0 z-50 bg-black/80 backdrop-blur-md hidden transition-opacity flex justify-start">
    <div class="bg-zinc-950 border-r border-purple-900/30 w-full max-w-md h-full flex flex-col p-5 shadow-2xl overflow-hidden">
      <!-- Drawer Header -->
      <div class="flex items-center justify-between pb-4 border-b border-zinc-800">
        <div>
          <h3 class="text-sm font-black font-cinzel text-white flex items-center gap-2">
            <span>SELECT CHAPTER</span>
            <span class="text-[10px] bg-purple-950 text-purple-300 border border-purple-800 px-2 py-0.5 rounded-full font-bold">100 SAGA</span>
          </h3>
          <p class="text-[10px] text-zinc-500">Tap to load reader strip & screenplay</p>
        </div>
        <button id="close-drawer-btn" class="p-1.5 hover:bg-zinc-900 rounded-full text-zinc-400 hover:text-white transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>

      <!-- Drawer Chapter List -->
      <div id="drawer-chapters-list" class="flex-1 overflow-y-auto py-3 space-y-2 pr-1">
        <!-- Injected dynamically -->
      </div>
    </div>
  </div>

  <!-- ======================================================= -->
  <!-- COMMENTS SLIDE-UP DRAWER -->
  <!-- ======================================================= -->
  <div id="comments-drawer" class="fixed inset-0 z-50 bg-black/80 backdrop-blur-sm hidden transition-opacity flex justify-end flex-col">
    <div class="bg-zinc-950 border-t border-zinc-800 rounded-t-3xl max-h-[80vh] flex flex-col p-5 max-w-xl mx-auto w-full shadow-2xl">
      <div class="flex items-center justify-between pb-3 border-b border-zinc-800">
        <div>
          <h3 class="text-sm font-bold text-white flex items-center gap-2">
            <span>Comments</span>
            <span id="drawer-comment-badge" class="text-[11px] bg-purple-950 text-purple-300 border border-purple-800 px-2 py-0.5 rounded-full font-bold">250K</span>
          </h3>
          <p class="text-[10px] text-zinc-500" id="comments-chapter-label">Chapter Comments</p>
        </div>
        <button id="close-comments-btn" class="p-1.5 hover:bg-zinc-900 rounded-full text-zinc-400 hover:text-white transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>

      <!-- Comments List -->
      <div id="comments-list" class="flex-1 overflow-y-auto py-4 space-y-3 pr-1 text-xs min-h-[160px] max-h-[50vh]">
        <!-- Dynamic comments from Supabase -->
      </div>

      <!-- Post Comment Form -->
      <form id="comment-form" class="pt-3 border-t border-zinc-800 flex gap-2">
        <input id="comment-author-input" type="text" placeholder="Name" class="w-24 bg-zinc-900 border border-zinc-800 rounded-xl px-3 py-2 text-xs text-zinc-200 placeholder-zinc-600 focus:outline-none focus:border-purple-500">
        <input id="comment-text-input" type="text" placeholder="Share your thoughts on this chapter..." required class="flex-1 bg-zinc-900 border border-zinc-800 rounded-xl px-3 py-2 text-xs text-zinc-200 placeholder-zinc-600 focus:outline-none focus:border-purple-500">
        <button type="submit" class="bg-purple-600 hover:bg-purple-500 text-white font-bold text-xs px-4 py-2 rounded-xl transition-all shadow-md">
          Post
        </button>
      </form>
    </div>
  </div>

  <!-- Bottom Floating Navigation Bar -->
  <div class="fixed bottom-3 left-1/2 -translate-x-1/2 z-40 bg-zinc-950/90 backdrop-blur-md border border-purple-900/40 rounded-full px-4 py-1.5 flex items-center gap-3 shadow-2xl text-[11px] text-zinc-300 select-none">
    <button onclick="prevChapter()" class="hover:text-purple-400 transition-colors flex items-center gap-1 font-bold cursor-pointer">
      <span>⏮ Prev</span>
    </button>
    <span class="text-zinc-700">|</span>
    <span id="page-percent" class="text-purple-400 font-bold font-orbitron text-xs">0%</span>
    <span class="text-zinc-700">|</span>
    <button onclick="nextChapter()" class="hover:text-purple-400 transition-colors flex items-center gap-1 font-bold cursor-pointer">
      <span>Next ⏭</span>
    </button>
  </div>

